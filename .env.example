# Copy this file to .env and fill in your own values.
# Never upload the real .env file to GitHub.

# Supabase: Project Settings, Data API (project URL) and API Keys (secret key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# A long random text (at least 32 characters) used to sign login tokens.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Websites allowed to call the API. Use * for any, or a comma-separated list.
CORS_ORIGINS=*
