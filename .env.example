# Copy this file to .env and fill in your own values.
# Never upload the real .env file to GitHub.

# Supabase: Project Settings, Data API (project URL) and API Keys (secret key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# A long random text (at least 32 characters) used to sign login tokens.
AUTH_SECRET=replace-with-at-least-32-random-characters

# The website's public address, used in emailed links. No trailing slash.
SITE_URL=https://your-site.vercel.app

# Gmail account that sends verification and password reset emails.
# Use an App Password, not the normal Gmail password. With 2-Step Verification on,
# create one at https://myaccount.google.com/apppasswords (it isn't linked from the menus).
GMAIL_ADDRESS=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password


# Google AI Studio key for the chat assistant.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Other websites allowed to call the API directly from a browser.
# Leave empty: the GPU Finder site calls it through its own /api rewrite.
CORS_ORIGINS=
